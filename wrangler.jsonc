// Cloudflare Workers deployment (free plan). See README, section « Déployer sur Cloudflare ».
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arrosoir",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arrosoir",
      // Replace with the id printed by: npx wrangler d1 create arrosoir
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/infrastructure/sqlite/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      // Replace with the id printed by: npx wrangler kv namespace create PHOTOS
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Contact sent to push services; Apple requires a real mailto: or https: URL.
    "VAPID_SUBJECT": "mailto:admin@example.com"
  }
}
