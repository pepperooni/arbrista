// Cloudflare Workers deployment (free plan). See README, section « Déployer sur Cloudflare ».
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arbrista",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arbrista",
      // No id: Wrangler creates the database on the first deploy and reuses it afterwards.
      "migrations_dir": "src/infrastructure/sqlite/migrations"
    }
  ],
  "kv_namespaces": [
    {
      // No id: Wrangler creates the namespace on the first deploy and reuses it afterwards.
      "binding": "PHOTOS"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Contact sent to push services; Apple requires a real mailto: or https: URL.
    "VAPID_SUBJECT": "mailto:admin@example.com"
  }
}
