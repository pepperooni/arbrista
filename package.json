{
  "name": "arrosoir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./web/tsconfig.json",
    "vapid-keys": "node scripts/vapid-keys.ts",
    "dev:cf": "npm run build && wrangler d1 migrations apply arrosoir --local && wrangler dev --local",
    "deploy:cf": "npm run build && wrangler d1 migrations apply arrosoir --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "valibot": "^1.5.0"
  }
}
